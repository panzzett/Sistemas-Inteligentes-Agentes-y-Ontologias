    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#ofreceCombustible -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#ofreceCombustible">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#EstacionServicio"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Combustible"/>
        <rdfs:comment xml:lang="es">Relaciona una estación de servicio con los tipos de combustible que ofrece.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#operadaPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#operadaPor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#EstacionServicio"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Operador"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tieneComunidadAutonoma -->

