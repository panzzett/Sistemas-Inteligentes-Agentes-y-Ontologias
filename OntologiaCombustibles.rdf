        <rdfs:range rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#ComunidadAutonoma"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tieneCoordenadas -->

