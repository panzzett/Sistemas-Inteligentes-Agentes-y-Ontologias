        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Municipio"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localidad"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tieneLocalizacion -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tieneLocalizacion">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#EstacionServicio"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localizacion"/>
        <rdfs:comment xml:lang="es">Relaciona una estación de servicio con su ubicación geográfica</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tieneMargen -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tieneMargen">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localizacion"/>
