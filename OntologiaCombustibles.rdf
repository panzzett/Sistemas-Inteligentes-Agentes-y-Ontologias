    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#codigoPostal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#codigoPostal">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Direccion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#direccion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#direccion">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Direccion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#horario -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#horario">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Horario"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#id -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#id">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#EstacionServicio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#latitud -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#latitud">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Coordenadas"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Valor numérico que indica la posición geográfica en el eje norte-sur</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#longitud -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#longitud">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Coordenadas"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Valor numérico que indica la posición geográfica en el eje este-oeste</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#margen -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#margen">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Margen"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#nombre -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#nombre">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#ComunidadAutonoma"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localidad"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Municipio"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Provincia"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#operador -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#operador">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Operador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#precioCombustible -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#precioCombustible">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Precio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Valor numérico que indica el coste del combustible.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#rotulo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#rotulo">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#EstacionServicio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tipoCombustible -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tipoCombustible">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Combustible"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2002/07/owl#topDataProperty -->

    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#topDataProperty">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Operador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Combustible -->

    <owl:Class rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Combustible">
        <rdfs:comment xml:lang="es">Tipo de producto ofrecido por una estación de servicio, como gasolina o gasóleo.</rdfs:comment>
        <rdfs:label xml:lang="es">Combustible</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#ComunidadAutonoma -->

    <owl:Class rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#ComunidadAutonoma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localizacion"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localidad"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Municipio"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Provincia"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Coordenadas -->

    <owl:Class rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Coordenadas">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localizacion"/>
        <rdfs:comment xml:lang="es">Par de valores numéricos (latitud y longitud) que indican la posición geográfica de una estación de servicio.</rdfs:comment>
        <rdfs:label xml:lang="es">Coordenadas</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Direccion -->

    <owl:Class rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Direccion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localizacion"/>
        <rdfs:comment xml:lang="es">Texto descriptivo que identifica la ubicación física de una estación de servicio dentro de una localidad.</rdfs:comment>
        <rdfs:label xml:lang="es">Dirección</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#EstacionServicio -->

    <owl:Class rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#EstacionServicio">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tienePrecio"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Precio"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#operadaPor"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Operador"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tieneHorario"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Horario"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tieneLocalizacion"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localizacion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Instalación donde se venden combustibles y se publican precios, junto con información de ubicación, horario y operador.</rdfs:comment>
        <rdfs:label xml:lang="es">Estación de Servicio</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Horario -->

    <owl:Class rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Horario">
        <rdfs:comment xml:lang="es">Información que describe los períodos de apertura y cierre de una estación de servicio.</rdfs:comment>
        <rdfs:label xml:lang="es">Horario</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localidad -->

    <owl:Class rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localidad">
