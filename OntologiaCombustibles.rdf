        <owl:disjointWith rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Provincia"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Operador -->

    <owl:Class rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Operador">
        <rdfs:comment xml:lang="es">Entidad responsable de la gestión y explotación de una estación de servicio.</rdfs:comment>
        <rdfs:label xml:lang="es">Operador</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Precio -->

    <owl:Class rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Precio">
