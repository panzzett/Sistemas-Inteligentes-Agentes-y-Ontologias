        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Provincia"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Municipio"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tienePrecio -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tienePrecio">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#EstacionServicio"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Precio"/>
        <rdfs:comment xml:lang="es">Relaciona una estación de servicio con los precios de los combustibles que publica.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tienePrecioCombustible -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tienePrecioCombustible">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Precio"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Combustible"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tieneProvincia -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#tieneProvincia">
