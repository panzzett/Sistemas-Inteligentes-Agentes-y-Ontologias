        <owl:disjointWith rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Municipio"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Provincia"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localizacion -->

    <owl:Class rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localizacion">
        <rdfs:comment xml:lang="es">Información geográfica que describe la ubicación de una estación de servicio.</rdfs:comment>
        <rdfs:label xml:lang="es">Localización</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Margen -->

    <owl:Class rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Margen">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Localizacion"/>
        <rdfs:comment xml:lang="es">Margen de la vía al que se encuentra la estación de servicio (D: Derecho, I: Izquierdo, N: No aplica)</rdfs:comment>
        <rdfs:label xml:lang="es">Margen</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Municipio -->

    <owl:Class rdf:about="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Municipio">
