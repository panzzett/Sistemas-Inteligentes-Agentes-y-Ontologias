        <rdfs:domain rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#ComunidadAutonoma"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/julio/ontologies/2026/0/untitled-ontology-2#Provincia"/>
    </owl:ObjectProperty>
    


